{
  "name": "foundry-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "bundle": "npm run build:bundle --workspaces --if-present",
    "dist": "npm run build && npm run bundle && node scripts/check-dist.mjs",
    "test": "jest --passWithNoTests",
    "lint": "eslint .",
    "clean": "tsc --build --clean && rimraf \"packages/*/build\" \"packages/*/dist\""
  },
  "dependencies": {
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jest": "^30.4.2",
    "jiti": "^2.6.1",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=20"
  }
}
