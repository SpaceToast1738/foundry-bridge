[Unit]
Description=foundry-bridge MCP gateway (Streamable HTTP)
Documentation=https://github.com/SpaceToast1738/foundry-bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=foundry-bridge
Group=foundry-bridge
WorkingDirectory=/opt/foundry-bridge
EnvironmentFile=/etc/foundry-bridge/env

# Runs the MCP server directly. The server exposes Streamable HTTP on
# FOUNDRY_BRIDGE_GATEWAY_PORT (default 31415) and opens the loopback relay
# on FOUNDRY_BRIDGE_PORT (default 31414) for the headless browser.
ExecStart=/usr/bin/node packages/mcp-server/build/server.js

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/foundry-bridge /var/log/foundry-bridge
ReadOnlyPaths=/etc/foundry-bridge
AmbientCapabilities=
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
