# /etc/caddy/sites-available/foundry-mcp.spencer-net.com
#
# Drop into your Caddy config (Caddyfile import or directly under your
# top-level Caddyfile). Caddy will obtain a TLS cert via ACME automatically.
#
# Required env vars (e.g. in /etc/default/caddy):
#   MCP_BRIDGE_TOKEN=<long random string>   # Authorization: Bearer <value>  (desktop / mcp-remote)
#   MCP_BRIDGE_PATH=<long random string>     # secret URL path for header-less clients (Claude phone/web connector)
#   FOUNDRY_BRIDGE_GATEWAY_PORT=31415
#
# Generate each secret with:  openssl rand -hex 32  — keep them DIFFERENT, rotate if exposed.

foundry-mcp.spencer-net.com {
    encode zstd gzip

    # --- Header-less access (Claude custom connector on phone/web) ---
    # Claude's connector dialog can't send a static bearer header, so the secret
    # *path* is the credential. Connector URL:
    #   https://foundry-mcp.spencer-net.com/<MCP_BRIDGE_PATH>/mcp
    # handle_path strips the /<secret> prefix, so the gateway still sees /mcp.
    # NOTE: MCP_BRIDGE_PATH MUST be a long random value — if it's empty this route
    # only matches "//..." paths (fail-closed) and normal /mcp still needs the bearer.
    handle_path /{$MCP_BRIDGE_PATH}/* {
        log_skip                       # keep the secret out of the access log
        reverse_proxy 127.0.0.1:{$FOUNDRY_BRIDGE_GATEWAY_PORT}
    }

    # --- Header-based access (desktop via mcp-remote --header) ---
    @authed header Authorization "Bearer {$MCP_BRIDGE_TOKEN}"
    handle @authed {
        reverse_proxy 127.0.0.1:{$FOUNDRY_BRIDGE_GATEWAY_PORT}
    }

    handle {
        header Content-Type text/plain
        respond "Unauthorized" 401
    }

    log {
        output file /var/log/caddy/foundry-mcp.spencer-net.com.log
        format json
    }
}
