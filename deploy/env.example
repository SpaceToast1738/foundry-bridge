# /etc/foundry-bridge/env
#
# Copy to /etc/foundry-bridge/env (chmod 640, owned by root:foundry-bridge)
# and adjust. The systemd units read this file; Caddy reads MCP_BRIDGE_TOKEN
# and FOUNDRY_BRIDGE_GATEWAY_PORT from its own environment (typically
# /etc/default/caddy).

# --- MCP server / relay ---
# Port the in-process loopback WebSocket relay listens on. The headless
# browser (running the foundry-bridge module) dials this URL. Leave at the
# default unless you need to avoid a clash.
FOUNDRY_BRIDGE_PORT=31414
FOUNDRY_BRIDGE_HOST=127.0.0.1

# Which credential entry the bridge should activate. Optional; defaults to
# the first entry in the credentials file.
FOUNDRY_BRIDGE_CREDENTIAL_ID=shattered-orrery

# Credentials JSON. See deploy/credentials.example.json.
FOUNDRY_CREDENTIALS=/etc/foundry-bridge/credentials.json

# --- Deploy (read by scripts/redeploy.sh) ---
# Target dir the module bundle is copied into (Foundry's modules/foundry-bridge).
# Set here so `sudo ./scripts/redeploy.sh` works without passing it by hand.
MODULE_DIR=/opt/foundry/data/Data/modules/foundry-bridge

# --- Alerting (Home Assistant) ---
# POSTed a small JSON body on every launcher state change (down / recovered).
# Point at an HA webhook to get a mobile push. Unset = disabled.
# FOUNDRY_BRIDGE_STATE_WEBHOOK=https://home.example.com/api/webhook/foundry-bridge

# --- MCP gateway (Streamable HTTP, served directly by mcp-server) ---
# HTTP port the gateway listens on. Caddy reverse-proxies into it after auth.
FOUNDRY_BRIDGE_GATEWAY_PORT=31415
# Interface the gateway binds. It has NO auth of its own — all auth lives in
# Caddy — so this is NOT loopback-only by default (0.0.0.0). On a shared host,
# other containers can reach it directly; keep 31415 firewalled (ufw) or bind
# the Docker-bridge IP so only Caddy can connect.
# FOUNDRY_BRIDGE_GATEWAY_HOST=0.0.0.0

# --- Sessions & audit (mcp-server) ---
# Idle MCP sessions are swept after this many ms (default 30 min) and capped
# (default 100) so the in-memory session map can't leak. Usually leave unset.
# FOUNDRY_BRIDGE_SESSION_TTL_MS=1800000
# FOUNDRY_BRIDGE_MAX_SESSIONS=100
# Durable JSONL audit log of every tool call ({ts,method,ok,ms,docIds,args}).
# Defaults to /var/lib/foundry-bridge/audit; set empty to disable. Must be a
# systemd ReadWritePaths dir under ProtectSystem=strict.
# FOUNDRY_BRIDGE_AUDIT_DIR=/var/lib/foundry-bridge/audit

# --- Backups ---
# Enables the `backup_world` MCP tool AND the daily foundry-bridge-backup.timer.
# The script snapshots the world and prints JSON, e.g. {"path":"…","bytes":123}.
# Leave set for scheduled + on-demand backups; unset to disable both.
FOUNDRY_BACKUP_SCRIPT=/opt/foundry-bridge/deploy/backup-world.sh
#   FOUNDRY_DATA_DIR    What to archive (default the whole data tree). Point at a
#                       single world dir for a lean snapshot, e.g.
#                       /opt/foundry/data/Data/worlds/<id>.
#   FOUNDRY_BACKUP_DIR  Output dir. MUST be under ProtectSystem=strict's
#                       ReadWritePaths — keep it under /var/lib/foundry-bridge
#                       (NOT /opt/..., which the hardened units mount read-only).
#   FOUNDRY_BACKUP_KEEP Retention: keep newest N archives, prune older (default 7;
#                       0 disables).
FOUNDRY_BACKUP_DIR=/var/lib/foundry-bridge/backups
FOUNDRY_BACKUP_KEEP=7
# FOUNDRY_DATA_DIR=/opt/foundry/data

# --- Headless browser ---
PLAYWRIGHT_USER_DATA_DIR=/var/lib/foundry-bridge/profile
FOUNDRY_BRIDGE_HEADLESS=true
FOUNDRY_BRIDGE_RELOAD_INTERVAL_MS=60000

# --- Caddy ---
# These live in Caddy's environment file (e.g. /etc/default/caddy), NOT this
# foundry-bridge one — listed here for reference. Generate each with
# `openssl rand -hex 32`, keep them different, and rotate if exposed.
#
# Bearer token header-based clients send as `Authorization: Bearer <value>`
# (desktop via mcp-remote).
# MCP_BRIDGE_TOKEN=__set_in_caddy_env__
#
# Secret URL path for header-less clients (Claude phone/web custom connector):
# the connector URL is https://<host>/<MCP_BRIDGE_PATH>/mcp — the path IS the
# credential. Must be set to a long random value (see the Caddyfile).
# MCP_BRIDGE_PATH=__set_in_caddy_env__
